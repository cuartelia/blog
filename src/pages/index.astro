---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { path } from '../lib/site';
const posts = (await getCollection('articulos', ({data})=>!data.draft)).sort((a,b)=>(a.data.order??99)-(b.data.order??99));
---
<BaseLayout>
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <div class="eyebrow"><span class="eyebrow-dot"></span> UN ESPACIO PARA APRENDER · ARGENTINA</div>
        <h1>El conocimiento<br/>también <em>salva.</em></h1>
        <p class="hero-lead">Detrás de cada vocación hay preguntas. Cuartelia es un lugar para explorarlas: historia bomberil, ciencia, formación y herramientas para entender mejor.</p>
        <div class="hero-actions"><a class="button button-primary" href={path('biblioteca/')}>Explorar la biblioteca <span aria-hidden="true">↗</span></a><a class="text-link" href={path('acerca/')}>Conocé el proyecto <span aria-hidden="true">→</span></a></div>
        <div class="hero-bottom-note"><span>01 / 03</span><span>UNA BITÁCORA DE CONOCIMIENTO ABIERTO</span></div>
      </div>
      <div class="hero-visual" role="img" aria-label="Ilustración geométrica de un casco de bombero dentro de círculos concéntricos">
        <div class="visual-rings"><span></span><span></span><span></span><span></span></div>
        <span class="visual-marker visual-marker--top">EST. 2026 <span>·</span> CUARTELIA</span>
        <svg class="hero-helmet" viewBox="0 0 460 410" fill="none" aria-hidden="true">
          <path d="M66 289c18-11 36-14 54-17l7-55c7-74 50-119 108-119 68 0 111 52 113 119l6 55c18 3 32 8 47 17-13 37-72 52-167 52S80 324 66 289Z" fill="#EF6747"/>
          <path d="M135 263c8-39 7-100 38-137 14-18 34-29 59-31-57 35-57 106-54 167Z" fill="#F88E68" opacity=".68"/>
          <path d="M283 109c41 20 65 60 67 121l4 44-47-11c0-46-7-105-24-154Z" fill="#BF462E" opacity=".75"/>
          <path d="M66 288c61-20 262-25 335 1-12 39-77 52-167 52S79 326 66 288Z" fill="#D75138"/>
          <path d="M78 294c83-10 238-16 312 0" stroke="#FFAB89" stroke-width="6" stroke-linecap="round"/>
          <path d="M126 276c59-10 160-12 226 0" stroke="#8E3529" stroke-width="3" opacity=".45"/>
          <path d="M204 98V73c0-12 10-22 22-22h16c12 0 22 10 22 22v25" fill="#F69A75" stroke="#F69A75" stroke-width="6"/>
          <path d="M196 157c9-7 25-12 39-12s28 5 38 12v66c0 30-18 45-38 55-23-12-39-25-39-55v-66Z" fill="#F6E9D3" stroke="#E5BD9F" stroke-width="5"/>
          <path d="M235 159c11 20 24 38 24 56a24 24 0 1 1-48 0c0-16 11-28 18-36-1 16 5 19 7 20 9-11 7-25-1-40Z" fill="#D9573D"/>
          <path d="M206 288h58" stroke="#13282D" stroke-width="4" stroke-linecap="round"/>
          <path d="M235 42v-17" stroke="#F6E9D3" stroke-width="2"/><path d="M44 290H24m413 0h-19" stroke="#F6E9D3" stroke-width="2"/>
        </svg>
        <div class="hero-seal"><span>APRENDER</span><strong>◆</strong><span>PARA SERVIR</span></div>
        <div class="hero-visual-footer"><span>HISTORIA · CIENCIA · OFICIO</span><span>◌ ◌ ◌</span></div>
      </div>
    </div>
  </section>

  <div class="principles"><div class="shell principles-inner"><span>CONOCER</span><span class="principle-star">◆</span><span>COMPRENDER</span><span class="principle-star">◆</span><span>COMPARTIR</span><span class="principle-star">◆</span><span>SEGUIR APRENDIENDO</span></div></div>

  <section class="section section-intro shell">
    <div class="section-topline"><span class="eyebrow eyebrow--dark">01 / PUNTO DE PARTIDA</span><span class="hairline"></span><span class="section-index">CUARTELIA · ARCHIVO VIVO</span></div>
    <div class="intro-layout"><h2>Una misma vocación.<br/><em>Muchas formas de aprender.</em></h2><div><p>Para quienes tienen curiosidad, están en formación o llevan años de experiencia. Un lugar independiente para cruzar preguntas, lecturas y conocimientos útiles.</p><a class="inline-link" href={path('acerca/')}>Sobre Cuartelia <span aria-hidden="true">↗</span></a></div></div>
    <div class="audiences"><a class="audience" href={path('biblioteca/?publico=Aspirantes')}><span class="audience-icon">↗</span><span class="audience-number">01</span><h3>Estoy empezando</h3><p>Para curiosos y futuros aspirantes.</p><span class="audience-arrow">→</span></a><a class="audience" href={path('biblioteca/?publico=Cadetes')}><span class="audience-icon">◆</span><span class="audience-number">02</span><h3>Estoy aprendiendo</h3><p>Para cadetes y personal en formación.</p><span class="audience-arrow">→</span></a><a class="audience" href={path('biblioteca/?publico=Bomberos')}><span class="audience-icon">⌁</span><span class="audience-number">03</span><h3>Sigo profundizando</h3><p>Para quienes ya conocen el oficio.</p><span class="audience-arrow">→</span></a></div>
  </section>

  <section class="section library-feature" id="publicaciones"><div class="shell">
    <div class="section-topline"><span class="eyebrow eyebrow--dark">02 / BIBLIOTECA ABIERTA</span><span class="hairline"></span><span class="section-index">LEER · REFLEXIONAR · EXPLORAR</span></div>
    <div class="section-heading-row"><div><h2>Preguntas que<br/><em>merecen un capítulo.</em></h2><p>Empezá por nuestras tres lecturas de muestra. Cada artículo incluye fuentes para seguir investigando.</p></div><a class="round-link" href={path('biblioteca/')} aria-label="Ver toda la biblioteca">↗</a></div>
    <div class="article-grid">{posts.slice(0,3).map((post,index)=><ArticleCard post={post} index={index}/>)}</div>
    <div class="section-end"><a class="inline-link" href={path('biblioteca/')}>Ver biblioteca completa <span aria-hidden="true">↗</span></a><span>CONTENIDO DE PRUEBA · 03 ARTÍCULOS</span></div>
  </div></section>

  <section class="lab-promo"><div class="shell lab-promo-grid"><div class="lab-promo-copy"><span class="eyebrow eyebrow--orange">03 / LABORATORIO INTERACTIVO</span><h2>No alcanza con leerlo.<br/><em>Hay que verlo cambiar.</em></h2><p>Mové variables, explorá relaciones y poné a prueba conceptos de presión y temperatura con modelos didácticos interactivos.</p><a class="button button-light" href={path('laboratorio/')}>Entrar al laboratorio <span aria-hidden="true">↗</span></a><span class="lab-small">MODELOS DIDÁCTICOS · SIN FINES OPERATIVOS</span></div><div class="lab-promo-art" aria-hidden="true"><div class="radial-lines"></div><div class="promo-gauge"><div class="promo-gauge-ruler">0 <span>PRESSURE / kPa</span> 500</div><div class="promo-dial"><div class="promo-needle"></div><div class="promo-dot"></div></div><div class="promo-gauge-bottom">PV = nRT</div></div><span class="promo-art-label">LABORATORIO<br/>CUARTELIA—001</span></div></div></section>

  <section class="section statement shell"><span class="eyebrow eyebrow--dark">POR QUÉ EXISTIMOS</span><div class="statement-layout"><span class="statement-asterisk">◆</span><div><blockquote>La formación no es el comienzo de la experiencia. Es el comienzo de <em>hacer mejores preguntas.</em></blockquote><p>Este proyecto no reemplaza cursos, procedimientos ni instructores. Es un espacio editorial independiente para ayudar a comprender conceptos y seguir investigando.</p><a href={path('acerca/')} class="inline-link">Nuestra mirada <span aria-hidden="true">↗</span></a></div></div></section>
</BaseLayout>
