---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AnalyticsNotice from '../components/AnalyticsNotice.astro';
import { brand, path } from '../lib/site';
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
}
const { title, description=brand.description, image=path('og/home.png'), type='website', publishedTime, modifiedTime }=Astro.props;
const pageTitle = title ? `${title} · Cuartelia` : 'Cuartelia — Conocimiento que nos acerca';
const canonical = new URL(Astro.url.pathname, Astro.site || Astro.url).toString();
const ogImage = new URL(image, Astro.site || Astro.url).toString();
// El tracking se activa solo cuando existe un ID válido configurado en el build.
const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID?.trim();
const umamiEnabled = Boolean(umamiWebsiteId && umamiWebsiteId !== 'xxx');
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f5ef" />
    <meta name="description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="Cuartelia" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={title ? `Cuartelia: ${title}` : 'Cuartelia — Historia, ciencia y formación bomberil'} />
    {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title ? `Cuartelia: ${title}` : "Cuartelia — Historia, ciencia y formación bomberil"} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={path('favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=DM+Mono:wght@400;500&family=Fraunces:opsz,wght,SOFT,WONK@9..144,400,0,1;9..144,500,0,1;9..144,600,0,1&display=swap" rel="stylesheet" />
    <title>{pageTitle}</title>
    {/* La carga de Umami y el aviso de error se controlan juntos. */}
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido"><slot /></main>
    <Footer />
    {umamiEnabled && <AnalyticsNotice websiteId={umamiWebsiteId} />}
  </body>
</html>
