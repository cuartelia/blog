---
import Brand from './Brand.astro';
import { path } from '../lib/site';
---
<footer class="site-footer">
  <div class="shell footer-grid">
    <div class="footer-intro">
      <Brand light />
      <p>Divulgación independiente sobre historia, ciencia y formación bomberil.</p>
    </div>
    <div class="footer-links"><h3>Explorar</h3><a href={path('biblioteca/')}>Biblioteca</a><a href={path('laboratorio/')}>Laboratorio</a><a href={path('acerca/')}>Acerca del proyecto</a><a href={path('privacidad/')}>Privacidad y estadísticas</a></div>
    <div class="footer-links"><h3>Sobre los contenidos</h3><p>Material educativo y divulgativo. No reemplaza la formación oficial ni los procedimientos operativos.</p></div>
  </div>
  <div class="shell footer-bottom"><span>© {new Date().getFullYear()} Cuartelia · Un proyecto de divulgación independiente.</span><a href="#arriba">Volver arriba ↑</a></div>
</footer>
