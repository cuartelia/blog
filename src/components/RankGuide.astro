---
/** Distintivos: recortes sin redibujar del Escalafón Jerárquico del SNBV. */
const groups = [
  {
    "label": "Suboficiales subalternos",
    "ranks": [
      {
        "name": "Cabo",
        "file": "cabo"
      },
      {
        "name": "Cabo Primero",
        "file": "cabo-primero"
      },
      {
        "name": "Sargento",
        "file": "sargento"
      }
    ]
  },
  {
    "label": "Suboficiales superiores",
    "ranks": [
      {
        "name": "Sargento Primero",
        "file": "sargento-primero"
      },
      {
        "name": "Suboficial Principal",
        "file": "suboficial-principal"
      },
      {
        "name": "Suboficial Mayor",
        "file": "suboficial-mayor"
      }
    ]
  },
  {
    "label": "Oficiales subalternos",
    "ranks": [
      {
        "name": "Oficial Ayudante",
        "file": "oficial-ayudante"
      },
      {
        "name": "Oficial Inspector",
        "file": "oficial-inspector"
      },
      {
        "name": "Oficial Principal",
        "file": "oficial-principal"
      }
    ]
  },
  {
    "label": "Oficiales jefes",
    "ranks": [
      {
        "name": "Sub-Comandante",
        "file": "subcomandante"
      },
      {
        "name": "Comandante",
        "file": "comandante"
      },
      {
        "name": "Comandante Mayor",
        "file": "comandante-mayor"
      }
    ]
  },
  {
    "label": "Oficial superior",
    "ranks": [
      {
        "name": "Comandante General",
        "file": "comandante-general"
      }
    ]
  }
];
const base = import.meta.env.BASE_URL;
---
<section class="rank-guide" aria-labelledby="rank-guide-title">
  <header><p class="guide-eyebrow">GUÍA DE IDENTIFICACIÓN / SNBV</p><h2 id="rank-guide-title">Reconocé las <em>jerarquías.</em></h2><p>Los distintivos se reproducen mediante recortes del escalafón oficial publicado por el Consejo Nacional de Bomberos Voluntarios, sin modificar sus componentes.</p></header>
  <div class="rank-intro"><strong>¿Y el grado Bombero?</strong> Es el grado de inicio del escalafón, pero el cuadro gráfico oficial no presenta una insignia para ese grado. No se le atribuye una imagen inventada.</div>
  {groups.map((group,i)=><section class="rank-group" aria-label={group.label}>
    <h3><span>{String(i+1).padStart(2,'0')}</span> {group.label}</h3>
    <div class="rank-grid">{group.ranks.map(rank=><article class="rank-item">
      <div class="rank-image"><img src={`${base}insignias/snbv/${rank.file}.png`} alt={`Distintivo oficial de ${rank.name}`} loading="lazy" decoding="async" /></div>
      <h4>{rank.name}</h4>
    </article>)}</div>
  </section>)}
  <div class="rank-foot"><p><strong>Fuente:</strong> <a href="https://www.bomberosra.org.ar/wp-content/uploads/2016/12/Escalafon-Jerarquico.pdf" rel="noopener noreferrer" target="_blank">Escalafón Jerárquico del Sistema Nacional de Bomberos Voluntarios ↗</a>, artículo 5 de la Ley 25.054. Las imágenes son recortes del documento oficial; para comprobar cada detalle consultá el documento completo.</p><p>El cuadro identifica los distintivos de grado, pero por sí solo <strong>no indica dónde deben colocarse en cada uniforme</strong>. La ubicación y forma de uso deben consultarse en la normativa pública de uniformidad que corresponda. La antigüedad tampoco equivale a un ascenso automático.</p></div>
</section>
<style>
.rank-guide{background:#182e32;color:#f8f6f0;padding:clamp(1.2rem,3.2vw,2.1rem);margin:1.5rem 0 3rem;border:1px solid #4c6261}.rank-guide header h2{font:500 clamp(2rem,4vw,3rem)/1.15 var(--serif,Georgia,serif);letter-spacing:-.04em;color:#fff;margin:.4rem 0 1rem}.rank-guide header h2 em{color:#ef9478}.rank-guide header p:last-child{color:#d1deda;font-size:.95rem}.guide-eyebrow{font:600 .68rem var(--mono,monospace);letter-spacing:.12em;color:#ffab91}.rank-intro{margin:1.5rem 0;padding:.9rem 1rem;border-left:3px solid #ffa084;background:#294349;font-size:.87rem;color:#e7eee9;line-height:1.6}.rank-group{margin-top:1.8rem}.rank-group h3{display:flex;gap:.75rem;align-items:baseline;font:500 1.3rem var(--serif,Georgia,serif);margin:0 0 .8rem;color:#fff}.rank-group h3 span{font:600 .65rem var(--mono,monospace);color:#ffab91}.rank-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,165px),1fr));gap:.65rem}.rank-item{min-width:0;border:1px solid #50686b;background:#274247;padding:.85rem .6rem;text-align:center}.rank-image{display:flex;align-items:center;justify-content:center;height:100px;padding:.4rem;background:#fffaf4;border-radius:2px}.rank-image img{display:block;max-width:100%;max-height:88px;width:auto;height:auto;object-fit:contain}.rank-item h4{font:700 .87rem var(--sans,system-ui,sans-serif);color:#fff;margin:.85rem 0 .15rem;line-height:1.3}.rank-foot{border-top:1px solid #526768;margin-top:1.8rem;padding-top:1rem}.rank-foot p{font-size:.8rem;color:#d0dcd6;line-height:1.7;margin:0 0 .9rem}.rank-foot a{color:#ffc0a9;text-decoration:underline;text-underline-offset:3px;overflow-wrap:anywhere}@media(max-width:480px){.rank-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.rank-image{height:82px}.rank-image img{max-height:70px}.rank-guide{padding:1rem}}
</style>
